{
  "rewrites": [
    {
      "destination": "/api/index.js",
      "source": "/api/(.*)"
    },
    {
      "destination": "/api/index.js",
      "source": "/painel"
    },
    {
      "destination": "/api/index.js",
      "source": "/motoboy"
    },
    {
      "destination": "/api/index.js",
      "source": "/pedido/(.*)"
    },
    {
      "destination": "/api/index.js",
      "source": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/keepalive",
      "schedule": "0 0 * * *"
    }
  ]
}
