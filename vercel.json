{
  "rewrites": [
    {
      "destination": "/api/index.js",
      "source": "/api/(.*)"
    },
    {
      "destination": "/api/index.js",
      "source": "/painel"
    },
    {
      "destination": "/api/index.js",
      "source": "/"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "node_modules/pdfkit/**",
        "node_modules/fontkit/**"
      ]
    }
  }
}
